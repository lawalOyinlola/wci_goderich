# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
# Use the new "Publishable" and "Secret" keys (recommended)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Legacy key names are also supported (for backward compatibility)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary Configuration
# Option 1: Use CLOUDINARY_URL (recommended - single env variable)
# Format: cloudinary://api_key:api_secret@cloud_name
# Get this from: https://cloudinary.com/console → Dashboard (copy the "Cloudinary URL")
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Public cloud name, required for client-side gallery image delivery URLs.
# This is the "cloud_name" portion of your CLOUDINARY_URL above (safe to expose).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Option 2: Use individual environment variables (alternative/fallback)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary Upload Presets (Optional - but recommended)
# Create presets in Cloudinary Dashboard → Settings → Upload presets
# If not set, code will fallback to manual transformation configuration
CLOUDINARY_UPLOAD_PRESET_BIRTHDAYS=wci_goderich_birthdays
CLOUDINARY_UPLOAD_PRESET_TESTIMONIES=wci_goderich_testimonies

# Admin API key (Optional, but required to use the admin routes)
# Unlocks editing, approving and deleting testimonies and prayer requests over
# the API (send it as the x-admin-api-key header). Without it those routes
# refuse every request. Generate one with: openssl rand -base64 32
# ADMIN_API_KEY=your_long_random_admin_key

# Cloudflare Turnstile bot check (Required in production)
# Create a widget at https://dash.cloudflare.com → Turnstile → Add widget,
# with your production domain and localhost as hostnames.
# In production, every form submission is refused while the secret is unset.
# In development, leaving both unset skips the check.
# Cloudflare's test keys always pass, for local testing:
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Site URL (Optional)
# Base URL used for SEO metadata, JSON-LD, sitemap.xml, and robots.txt.
# Falls back to https://wcigoderich.org if unset.
# NEXT_PUBLIC_SITE_URL=https://wcigoderich.org

# Contact Form Email (Optional, but configure one before launch)
# Without either option, messages are still saved to the contact_messages
# table and the sender sees a success message, but nobody is emailed.
# Development also logs the message to the console; production logs nothing.

# Option 1: Resend (tried first if set). Get a key at https://resend.com/api-keys
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=contact@wcigoderich.org

# Option 2: SMTP (fallback). Works with Gmail, Outlook, or any SMTP provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM_EMAIL=contact@wcigoderich.org
